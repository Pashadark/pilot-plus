  ownerProfile     OwnerProfile @relation(fields: [companyId, ownerProfileId], references: [companyId, id], onDelete: Cascade)
  vehicleId        String
  vehicle          Vehicle      @relation(fields: [companyId, vehicleId], references: [companyId, id], onDelete: Cascade)
  assignedByUserId String
  assignedBy       User         @relation("OwnerVehicleAccessAssignedBy", fields: [assignedByUserId], references: [id], onDelete: Restrict)
  startsAt         DateTime     @default(now()) @db.Timestamptz(3)
  endsAt           DateTime?    @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)

  @@unique([ownerProfileId, vehicleId, startsAt])
  @@index([ownerProfileId, startsAt, endsAt])
  @@index([companyId, vehicleId, startsAt, endsAt])
  @@index([assignedByUserId, createdAt])
}

model OwnerRevenueRule {
  id               String       @id @default(cuid())
  companyId        String
  company          Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ownerProfileId   String
  ownerProfile     OwnerProfile @relation(fields: [companyId, ownerProfileId], references: [companyId, id], onDelete: Cascade)
  shareBasisPoints Int          @default(4000)
  startsAt         DateTime     @default(now()) @db.Timestamptz(3)
  endsAt           DateTime?    @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)

  @@unique([ownerProfileId, startsAt])
  @@index([ownerProfileId, startsAt, endsAt])
}

model OwnerLedgerEntry {
  id               String               @id @default(cuid())
  companyId        String
  company          Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  ownerProfileId   String
  ownerProfile     OwnerProfile         @relation(fields: [companyId, ownerProfileId], references: [companyId, id], onDelete: Restrict)
  vehicleId        String
  vehicle          Vehicle              @relation(fields: [companyId, vehicleId], references: [companyId, id], onDelete: Restrict)
  rentalPaymentId  String?
  rentalPayment    RentalPayment?       @relation(fields: [companyId, rentalPaymentId], references: [companyId, id], onDelete: Restrict)
  kind             OwnerLedgerEntryKind
  amountMinor      BigInt
  currency         String               @default("RUB") @db.Char(3)
  shareBasisPoints Int
  recognizedOn     DateTime             @db.Date
  idempotencyKey   String               @unique
  note             String?
  createdAt        DateTime             @default(now()) @db.Timestamptz(3)

  @@index([ownerProfileId, recognizedOn, createdAt])
  @@index([companyId, vehicleId, recognizedOn])
  @@index([companyId, rentalPaymentId])
}

model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}
