generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
}

enum CompanyRole {
  ADMIN
}

enum VehicleStatus {
  MOVING
  IDLE
  OFFLINE
  MAINTENANCE
  UNKNOWN
}

enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
  OTHER
}

enum TelemetrySeverity {
  INFO
  WARNING
  DANGER
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  name         String
  passwordHash String
  role         UserRole        @default(ADMIN)
  isActive     Boolean         @default(true)
  sessions     Session[]
  memberships  CompanyMember[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model LoginThrottle {
  email          String    @id
  failedAttempts Int       @default(0)
  lastFailedAt   DateTime?
  lockedUntil    DateTime?
}

model Company {
  id        String          @id @default(cuid())
  name      String
  slug      String          @unique
  members   CompanyMember[]
  vehicles  Vehicle[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model CompanyMember {
  id        String      @id @default(cuid())
  companyId String
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      CompanyRole @default(ADMIN)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([companyId, userId])
  @@index([userId])
}

model Vehicle {
  id                 String              @id @default(cuid())
  companyId          String
  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sourceKey          String              @unique
  internalNumber     String
  model              String
  city               String
  office             String?
  registrationNumber String?
  vin                String?
  transmission       String
  engineLiters       Decimal?            @db.Decimal(3, 1)
  fuelType           FuelType
  seats              Int
  dailyPriceMinor    Int
  currency           String              @db.Char(3)
  originalPrice      String
  features           String[]            @default([])
  status             VehicleStatus       @default(UNKNOWN)
  isDemoImport       Boolean             @default(true)
  positions          VehiclePosition[]
  trips              Trip[]
  events             VehicleEvent[]
  fuelRecords        FuelRecord[]
  maintenanceRecords MaintenanceRecord[]
  documents          VehicleDocument[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([companyId, internalNumber])
  @@index([companyId, status])
  @@index([companyId, city])
}

model VehiclePosition {
  id               String   @id @default(cuid())
  vehicleId        String
  vehicle          Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  latitude         Decimal  @db.Decimal(9, 6)
  longitude        Decimal  @db.Decimal(9, 6)
  speedKph         Int?
  heading          Int?
  odometerKm       Decimal? @db.Decimal(12, 1)
  fuelLevelPercent Decimal? @db.Decimal(5, 2)
  recordedAt       DateTime
  createdAt        DateTime @default(now())

  @@index([vehicleId, recordedAt])
}

model Trip {
  id              String    @id @default(cuid())
  vehicleId       String
  vehicle         Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  startedAt       DateTime
  endedAt         DateTime?
  distanceKm      Decimal?  @db.Decimal(12, 1)
  durationSeconds Int?
  averageSpeedKph Int?
  maximumSpeedKph Int?
  fuelUsedLiters  Decimal?  @db.Decimal(10, 2)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([vehicleId, startedAt])
}

model VehicleEvent {
  id          String            @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type        String
  severity    TelemetrySeverity
  title       String
  description String?
  location    String?
  recordedAt  DateTime
  createdAt   DateTime          @default(now())

  @@index([vehicleId, recordedAt])
  @@index([severity, recordedAt])
}

model FuelRecord {
  id           String   @id @default(cuid())
  vehicleId    String
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type         String
  volumeLiters Decimal? @db.Decimal(10, 2)
  levelPercent Decimal? @db.Decimal(5, 2)
  consumption  Decimal? @db.Decimal(10, 2)
  recordedAt   DateTime
  createdAt    DateTime @default(now())

  @@index([vehicleId, recordedAt])
}

model MaintenanceRecord {
  id          String    @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      String
  odometerKm  Decimal?  @db.Decimal(12, 1)
  scheduledAt DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([vehicleId, scheduledAt])
}

model VehicleDocument {
  id        String    @id @default(cuid())
  vehicleId String
  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type      String
  title     String
  reference String?
  issuedAt  DateTime?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([vehicleId, expiresAt])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}
