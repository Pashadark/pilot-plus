generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  MEMBER
}

enum CompanyRole {
  COMPANY_ADMIN
  DISPATCHER
  DRIVER
  VIEWER
}

enum CompanyPermission {
  MANAGE_USERS
  MANAGE_ROLES
  VIEW_CLIENTS
  MANAGE_CLIENTS
  MANAGE_VEHICLES
  MANAGE_DEVICES
  MANAGE_DOCUMENTS
  MANAGE_MAINTENANCE
  MANAGE_WASH
  VIEW_REPORTS
  VIEW_AUDIT
  VIEW_FINES
  MANAGE_FINES
}

enum FineStatus {
  NEW
  UNPAID
  PAID
  CANCELLED
  OVERDUE
}

enum FineInvoiceStatus {
  PENDING
  CREATED
  SANDBOX_RETURNED
  SUCCEEDED
  FAILED
  ERROR
}

enum FineAssignmentSource {
  AUTOMATIC
  AUTO_EXACT
  MANUAL
}

enum ClientStatus {
  DRAFT
  NEW
  VERIFYING
  VERIFIED
  REGULAR
  BLOCKED
  ARCHIVED
}

enum ClientDocumentCategory {
  PASSPORT
  DRIVER_LICENSE
  CONTRACT
  POWER_OF_ATTORNEY
  MEDICAL
  OTHER
}

enum ClientCommentCategory {
  GENERAL
  POSITIVE
  PROBLEM
  DAMAGE
  PAYMENT
  VIOLATION
}

enum ClientCommentSeverity {
  INFO
  WARNING
  DANGER
}

enum DocumentScanStatus {
  UPLOADING
  PENDING
  CLEAN
  BLOCKED
  ERROR
  ARCHIVED
}

enum AuditAction {
  CREATE
  UPDATE
  ASSIGN
  BLOCK
  ARCHIVE
  DELETE
  VIEW
  DOWNLOAD
  SCAN
}

enum AuditEntityType {
  COMPANY
  CLIENT
  USER
  ROLE
  VEHICLE
  DEVICE
  DOCUMENT
  CLIENT_DOCUMENT
  RENTAL
  FINE
  FINE_INTEGRATION
  SYSTEM
}

enum VehicleStatus {
  MOVING
  IDLE
  OFFLINE
  MAINTENANCE
  UNKNOWN
}

enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
  OTHER
}

enum TelemetrySeverity {
  INFO
  WARNING
  DANGER
}

enum ManualVehicleEventKind {
  NOTE
  INCIDENT
  ASSIGNMENT
}

enum MaintenanceStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

enum MaintenanceKind {
  OIL
  FILTERS
  BRAKES
  TIRES
  TIMING
  INSPECTION
  OTHER
}

enum WashStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum WashKind {
  BODY
  COMPLEX
  INTERIOR
  MATS
  ENGINE
  OTHER
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  WARNING
  UNASSIGNED
  DISABLED
}

enum DeviceConnectionType {
  LTE
  GSM
  NONE
}

enum DevicePowerSource {
  VEHICLE
  BATTERY
}

enum FirmwareChannel {
  STABLE
  BETA
}

enum DeviceCommandType {
  REBOOT
  SHUTDOWN
  UPDATE_FIRMWARE
}

enum DeviceCommandStatus {
  PENDING
  SENT
  COMPLETED
  FAILED
  CANCELLED
}

enum RentalStatus {
  DRAFT
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum RentalDocumentFormat {
  DOCX
  PDF
}

enum RentalDocumentGenerationStatus {
  PENDING
  PROMOTED
  CLEANING
  COMMITTED
  ERROR
}

enum TelegramIdentityKind {
  CLIENT
  STAFF
}

enum BotFulfillmentMode {
  OFFICE
  DELIVERY
}

enum BotRentalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum BotNotificationStatus {
  PENDING
  PROCESSING
  SENT
  ERROR
}

model User {
  id                       String                    @id @default(cuid())
  email                    String                    @unique
  name                     String
  passwordHash             String
  role                     UserRole                  @default(MEMBER)
  isActive                 Boolean                   @default(true)
  sessions                 Session[]
  memberships              CompanyMember[]
  deviceCommands           DeviceCommand[]
  manualVehicleEvents      ManualVehicleEvent[]
  eventReadReceipts        EventReadReceipt[]
  auditLogs                AuditLog[]
  createdClients           Client[]
  createdClientDocuments   ClientDocument[]
  clientUploadPermits      ClientUploadPermit[]
  createdRentals           Rental[]                  @relation("RentalCreatedBy")
  confirmedRentals         Rental[]                  @relation("RentalConfirmedBy")
  createdContractTemplates ContractTemplateVersion[] @relation("ContractTemplateCreatedBy")
  archivedVehicles         Vehicle[]                 @relation("VehicleArchivedBy")
  authoredClientComments   ClientComment[]           @relation("ClientCommentAuthor")
  hiddenClientComments     ClientComment[]           @relation("ClientCommentHiddenBy")
  authoredFineComments     Fine[]                    @relation("FineCommentAuthor")
  confirmedFineAssignments Fine[]                    @relation("FineAssignmentConfirmedBy")
  fineAssignments          FineAssignmentHistory[]   @relation("FineAssignmentActor")
  initiatedFineInvoices    FineInvoice[]             @relation("FineInvoiceInitiatedBy")
  telegramIdentities       TelegramIdentity[]        @relation("TelegramIdentityUser")
  createdTelegramInvites   TelegramInvite[]          @relation("TelegramInviteCreator")
  boundTelegramGroups      TelegramGroupBinding[]
  decidedBotRentalRequests BotRentalRequest[]        @relation("BotRentalRequestDecider")
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model LoginThrottle {
  email          String    @id
  failedAttempts Int       @default(0)
  lastFailedAt   DateTime?
  lockedUntil    DateTime?
}

model Company {
  id                        String                     @id @default(cuid())
  name                      String
  slug                      String                     @unique
  inn                       String?
  kpp                       String?
  ogrn                      String?
  directorName              String?
  legalAddress              String?
  actualAddress             String?
  phone                     String?
  email                     String?
  legalName                 String?
  entrepreneurName          String?
  lessorBirthDate           DateTime?                  @db.Date
  lessorPassportEncrypted   String?
  ogrnip                    String?
  bankName                  String?
  settlementAccount         String?
  correspondentAccount      String?
  bik                       String?
  contractCity              String?
  defaultPickupAddress      String?
  defaultReturnAddress      String?
  signatoryName             String?
  signatoryAuthority        String?
  isDemo                    Boolean                    @default(false)
  members                   CompanyMember[]
  vehicles                  Vehicle[]
  devices                   Device[]
  deviceCommands            DeviceCommand[]
  manualVehicleEvents       ManualVehicleEvent[]
  eventReadReceipts         EventReadReceipt[]
  auditLogs                 AuditLog[]
  clients                   Client[]
  clientDocuments           ClientDocument[]
  clientUploadPermits       ClientUploadPermit[]
  clientStorageLedger       ClientStorageLedger?
  rentals                   Rental[]
  rentalNumberCounters      RentalNumberCounter[]
  rentalDrivers             RentalDriver[]
  rentalDocumentVersions    RentalDocumentVersion[]
  rentalDocumentGenerations RentalDocumentGeneration[]
  contractTemplates         ContractTemplateVersion[]
  clientComments            ClientComment[]
  fineIntegration           FineIntegration?
  externalVehicleLinks      ExternalVehicleLink[]
  telematicsIntegration     TelematicsIntegration?
  telematicsVehicleLinks    TelematicsVehicleLink[]
  fines                     Fine[]
  fineAssignmentHistory     FineAssignmentHistory[]
  fineInvoices              FineInvoice[]
  telegramIdentities        TelegramIdentity[]
  telegramInvites           TelegramInvite[]
  telegramGroupBinding      TelegramGroupBinding?
  botRentalRequests         BotRentalRequest[]
  botNotificationJobs       BotNotificationJob[]
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
}

model CompanyMember {
  id                    String              @id @default(cuid())
  companyId             String
  company               Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId                String
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  role                  CompanyRole         @default(VIEWER)
  additionalPermissions CompanyPermission[] @default([])
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([companyId, userId])
  @@index([userId])
}

model Client {
  id                           String              @id @default(cuid())
  companyId                    String
  company                      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  firstName                    String
  middleName                   String?
  lastName                     String
  birthDate                    DateTime?
  gender                       String?
  phoneEncrypted               String
  phoneIndex                   String
  additionalPhoneEncrypted     String?
  email                        String?
  telegramUsername             String?
  telegramUserId               String?
  maxUserId                    String?
  photoPath                    String?
  photoBytes                   Int                 @default(0)
  registrationAddressEncrypted String?
  actualAddressEncrypted       String?
  passportEncrypted            String?
  passportIndex                String?
  driverLicenseEncrypted       String?
  driverLicenseIndex           String?
  driverCategories             String[]
  driverLicenseIssuedAt        DateTime?
  driverLicenseExpiresAt       DateTime?
  drivingSince                 DateTime?
  emergencyContactEncrypted    String?
  source                       String?
  note                         String?
  status                       ClientStatus        @default(NEW)
  createdByUserId              String
  createdBy                    User                @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt                    DateTime            @default(now())
  updatedAt                    DateTime            @updatedAt
  archivedAt                   DateTime?
  documents                    ClientDocument[]
  photoUploads                 ClientPhotoUpload[]
  rentals                      Rental[]            @relation("ClientRentals")
  rentalDriverLinks            RentalDriver[]      @relation("ClientRentalDriver")
  comments                     ClientComment[]
  fines                        Fine[]
  telegramIdentity             TelegramIdentity?
  botRentalRequests            BotRentalRequest[]

  @@unique([companyId, phoneIndex])
  @@unique([companyId, id])
  @@index([companyId, status, updatedAt])
  @@index([companyId, lastName, firstName])
}

model ClientPhotoUpload {
  id                   String    @id @default(cuid())
  uploadId             String    @unique
  companyId            String
  clientId             String
  client               Client    @relation(fields: [companyId, clientId], references: [companyId, id], onDelete: Cascade)
  sourceStorageKey     String
  finalStorageKey      String    @unique
  previousPhotoPath    String?
  sourceBytes          Int       @default(0)
  finalBytes           Int?
  previousPhotoBytes   Int       @default(0)
  ledgerCommittedBytes Int       @default(0)
  status               String    @default("PENDING")
  scanVerdict          String?
  claimToken           String?   @unique
  sha256               String?
  leaseExpiresAt       DateTime?
  committedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([status, leaseExpiresAt])
  @@index([companyId, clientId, status])
}

model ClientComment {
  id             String                @id @default(cuid())
  companyId      String
  company        Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client                @relation(fields: [companyId, clientId], references: [companyId, id], onDelete: Cascade)
  rentalId       String?
  rental         Rental?               @relation(fields: [companyId, rentalId], references: [companyId, id], onDelete: Restrict)
  authorUserId   String
  author         User                  @relation("ClientCommentAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  category       ClientCommentCategory @default(GENERAL)
  severity       ClientCommentSeverity @default(INFO)
  text           String
  isPinned       Boolean               @default(false)
  hiddenAt       DateTime?
  hiddenByUserId String?
  hiddenBy       User?                 @relation("ClientCommentHiddenBy", fields: [hiddenByUserId], references: [id], onDelete: Restrict)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([companyId, clientId, isPinned, createdAt])
  @@index([companyId, rentalId, createdAt])
}

model ClientDocument {
  id              String                  @id @default(cuid())
  companyId       String
  company         Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientId        String
  client          Client                  @relation(fields: [companyId, clientId], references: [companyId, id], onDelete: Cascade)
  category        ClientDocumentCategory
  title           String
  numberEncrypted String?
  issuedAt        DateTime?
  expiresAt       DateTime?
  status          DocumentScanStatus      @default(UPLOADING)
  currentVersion  Int                     @default(1)
  createdByUserId String
  createdBy       User                    @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  archivedAt      DateTime?
  versions        ClientDocumentVersion[]
  rentalDocuments RentalDocumentVersion[]

  @@unique([companyId, clientId, id])
  @@index([companyId, clientId, status])
}

model ClientDocumentVersion {
  id                    String                 @id @default(cuid())
  documentId            String
  document              ClientDocument         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadId              String?                @unique
  version               Int
  storageKey            String                 @unique
  originalName          String
  verifiedMime          String
  bytes                 Int
  sha256                String
  scanEngine            String?
  signatureVersion      String?
  scanVerdict           String?
  scanLeaseExpiresAt    DateTime?
  claimToken            String?                @unique
  scanRetryCount        Int                    @default(0)
  quarantineExpiresAt   DateTime?
  cleanupPending        Boolean                @default(false)
  cleanupLeaseExpiresAt DateTime?
  storageDeletedAt      DateTime?
  ledgerCommittedBytes  Int                    @default(0)
  scannedAt             DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  rentalDocumentVersion RentalDocumentVersion?

  @@unique([documentId, version])
  @@unique([documentId, id])
  @@index([documentId, createdAt])
  @@index([scanVerdict, scanLeaseExpiresAt])
  @@index([cleanupPending, cleanupLeaseExpiresAt])
}

model ClientUploadPermit {
  id             String    @id @default(cuid())
  uploadId       String    @unique
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind           String
  status         String    @default("ACTIVE")
  reservedBytes  Int
  leaseExpiresAt DateTime
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([companyId, status, leaseExpiresAt])
  @@index([userId, status, leaseExpiresAt])
  @@index([companyId, createdAt])
  @@index([userId, createdAt])
}

model ClientStorageLedger {
  companyId      String    @id
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  committedBytes BigInt    @default(0)
  reservedBytes  BigInt    @default(0)
  reconciledAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model AuditLog {
  id                 String          @id @default(cuid())
  companyId          String?
  company            Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  actorUserId        String?
  actorUser          User?           @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorEmailSnapshot String
  action             AuditAction
  entityType         AuditEntityType
  entityId           String?
  entityLabel        String?
  changes            Json?
  createdAt          DateTime        @default(now())

  @@index([companyId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
}

model Vehicle {
  id                            String                  @id @default(cuid())
  companyId                     String
  company                       Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sourceKey                     String                  @unique
  internalNumber                String
  model                         String
  city                          String
  office                        String?
  registrationNumber            String?
  registrationNumberNormalized  String?
  vin                           String?
  vinNormalized                 String?
  make                          String?
  modelName                     String?
  generation                    String?
  trim                          String?
  manufacturedYear              Int?
  color                         String?
  category                      String?
  bodyType                      String?
  transmission                  String
  engineLiters                  Decimal?                @db.Decimal(3, 1)
  fuelType                      FuelType
  seats                         Int
  dailyPriceMinor               Int
  rangePriceMinor               BigInt?
  currency                      String                  @db.Char(3)
  odometerKm                    Decimal?                @db.Decimal(12, 1)
  valueMinor                    BigInt?
  depositMinor                  BigInt?
  includedMileageKm             Int?
  overageMileagePriceMinor      BigInt?
  missingFuelPriceMinor         BigInt?
  registrationCertificateNumber String?
  vehiclePassportNumber         String?
  osagoInsurer                  String?
  osagoPolicyNumber             String?
  osagoStartsAt                 DateTime?               @db.Date
  osagoEndsAt                   DateTime?               @db.Date
  cascoInsurer                  String?
  cascoPolicyNumber             String?
  cascoStartsAt                 DateTime?               @db.Date
  cascoEndsAt                   DateTime?               @db.Date
  isRentalReady                 Boolean                 @default(false)
  rentalReadyAt                 DateTime?               @db.Timestamptz(3)
  archivedAt                    DateTime?               @db.Timestamptz(3)
  archivedByUserId              String?
  archivedBy                    User?                   @relation("VehicleArchivedBy", fields: [archivedByUserId], references: [id], onDelete: SetNull)
  originalPrice                 String
  features                      String[]                @default([])
  status                        VehicleStatus           @default(UNKNOWN)
  isDemoImport                  Boolean                 @default(true)
  positions                     VehiclePosition[]
  trips                         Trip[]
  events                        VehicleEvent[]
  fuelRecords                   FuelRecord[]
  maintenanceRecords            MaintenanceRecord[]
  washRecords                   WashRecord[]
  documents                     VehicleDocument[]
  images                        VehicleImage[]
  device                        Device?
  manualVehicleEvents           ManualVehicleEvent[]
  rentals                       Rental[]                @relation("VehicleRentals")
  botRentalRequests             BotRentalRequest[]
  externalFineLinks             ExternalVehicleLink[]
  telematicsLinks               TelematicsVehicleLink[]
  fines                         Fine[]
  createdAt                     DateTime                @default(now())
  updatedAt                     DateTime                @updatedAt

  @@unique([companyId, internalNumber])
  @@unique([companyId, id])
  @@unique([companyId, registrationNumberNormalized])
  @@unique([companyId, vinNormalized])
  @@index([companyId, status])
  @@index([companyId, city])
  @@index([companyId, archivedAt])
}

model FineIntegration {
  id             String    @id @default(cuid())
  companyId      String    @unique
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  provider       String    @default("DRIVER_HELPER")
  tokenEncrypted String
  enabled        Boolean   @default(true)
  lastAttemptAt  DateTime? @db.Timestamptz(3)
  lastSuccessAt  DateTime? @db.Timestamptz(3)
  lastErrorCode  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model ExternalVehicleLink {
  id                           String   @id @default(cuid())
  companyId                    String
  company                      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicleId                    String?
  vehicle                      Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  provider                     String   @default("DRIVER_HELPER")
  externalId                   String
  registrationNumberNormalized String?
  registrationCertificateIndex String?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  @@unique([companyId, provider, externalId])
  @@index([companyId, vehicleId])
}

model TelematicsIntegration {
  id                String    @id @default(cuid())
  companyId         String    @unique
  company           Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  provider          String    @default("GLONASSSOFT")
  baseUrl           String
  usernameEncrypted String
  passwordEncrypted String
  enabled           Boolean   @default(true)
  lastAttemptAt     DateTime? @db.Timestamptz(3)
  lastSuccessAt     DateTime? @db.Timestamptz(3)
  lastErrorCode     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model TelematicsVehicleLink {
  id                           String   @id @default(cuid())
  companyId                    String
  company                      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicleId                    String
  vehicle                      Vehicle  @relation(fields: [companyId, vehicleId], references: [companyId, id], onDelete: Cascade)
  provider                     String   @default("GLONASSSOFT")
  externalId                   String
  registrationNumberNormalized String
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  @@unique([companyId, provider, externalId])
  @@unique([companyId, provider, vehicleId])
}

model Fine {
  id                          String                  @id @default(cuid())
  companyId                   String
  company                     Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicleId                   String?
  vehicle                     Vehicle?                @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  rentalId                    String?
  rental                      Rental?                 @relation(fields: [rentalId], references: [id], onDelete: SetNull)
  clientId                    String?
  client                      Client?                 @relation(fields: [clientId], references: [id], onDelete: SetNull)
  provider                    String                  @default("DRIVER_HELPER")
  externalId                  String
  providerVehicleId           String?
  uin                         String?
  decreeNumber                String
  decreeAt                    DateTime?               @db.Timestamptz(3)
  offenseAt                   DateTime                @db.Timestamptz(3)
  discountExpiresAt           DateTime?               @db.Timestamptz(3)
  originalAmountMinor         BigInt
  currentAmountMinor          BigInt
  discountPercent             Int?
  articleCode                 String?
  description                 String?
  address                     String?
  latitude                    Decimal?                @db.Decimal(9, 6)
  longitude                   Decimal?                @db.Decimal(9, 6)
  status                      FineStatus              @default(NEW)
  toBailiff                   Boolean                 @default(false)
  providerComment             String?
  comment                     String?
  commentedAt                 DateTime?               @db.Timestamptz(3)
  commentedByUserId           String?
  commentedByUser             User?                   @relation("FineCommentAuthor", fields: [commentedByUserId], references: [id], onDelete: SetNull)
  assignmentSource            FineAssignmentSource?
  assignmentConfirmedAt       DateTime?               @db.Timestamptz(3)
  assignmentConfirmedByUserId String?
  assignmentConfirmedByUser   User?                   @relation("FineAssignmentConfirmedBy", fields: [assignmentConfirmedByUserId], references: [id], onDelete: SetNull)
  photoState                  String?
  providerUpdatedAt           DateTime?               @db.Timestamptz(3)
  lastSyncedAt                DateTime                @db.Timestamptz(3)
  assignmentHistory           FineAssignmentHistory[]
  invoiceItems                FineInvoiceItem[]
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt

  @@unique([companyId, provider, externalId])
  @@unique([companyId, id])
  @@index([companyId, status, offenseAt])
  @@index([companyId, vehicleId, offenseAt])
  @@index([companyId, providerVehicleId])
  @@index([companyId, clientId, offenseAt])
}

model FineInvoice {
  id                    String            @id @default(cuid())
  companyId             String
  company               Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  provider              String            @default("DRIVER_HELPER")
  providerInvoiceId     String?           @unique
  status                FineInvoiceStatus @default(PENDING)
  sandbox               Boolean           @default(true)
  fineAmountMinor       BigInt
  commissionAmountMinor BigInt
  totalAmountMinor      BigInt
  initiatedByUserId     String
  initiatedByUser       User              @relation("FineInvoiceInitiatedBy", fields: [initiatedByUserId], references: [id], onDelete: Restrict)
  idempotencyKey        String            @unique
  paymentHost           String?           @db.VarChar(253)
  createdAt             DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @db.Timestamptz(3)
  items                 FineInvoiceItem[]

  @@unique([companyId, id])
  @@index([companyId, status])
  @@index([initiatedByUserId, createdAt])
}

model FineInvoiceItem {
  id        String      @id @default(cuid())
  companyId String
  invoiceId String
  invoice   FineInvoice @relation(fields: [companyId, invoiceId], references: [companyId, id], onDelete: Cascade)
  fineId    String
  fine      Fine        @relation(fields: [companyId, fineId], references: [companyId, id], onDelete: Restrict)
  active    Boolean     @default(true)
  createdAt DateTime    @default(now()) @db.Timestamptz(3)

  @@unique([invoiceId, fineId])
  @@index([companyId, invoiceId])
  @@index([companyId, fineId])
}

model FineAssignmentHistory {
  id          String               @id @default(cuid())
  companyId   String
  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fineId      String
  fine        Fine                 @relation(fields: [fineId], references: [id], onDelete: Cascade)
  vehicleId   String?
  rentalId    String?
  clientId    String?
  source      FineAssignmentSource
  reason      String?
