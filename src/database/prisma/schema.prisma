generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  MEMBER
}

enum CompanyRole {
  COMPANY_ADMIN
  DISPATCHER
  DRIVER
  VIEWER
}

enum CompanyPermission {
  MANAGE_USERS
  MANAGE_ROLES
  VIEW_CLIENTS
  MANAGE_CLIENTS
  MANAGE_VEHICLES
  MANAGE_DEVICES
  MANAGE_DOCUMENTS
  MANAGE_MAINTENANCE
  MANAGE_WASH
  VIEW_REPORTS
  VIEW_AUDIT
  VIEW_FINES
  MANAGE_FINES
}

enum FineStatus {
  NEW
  UNPAID
  PAID
  CANCELLED
  OVERDUE
  ARCHIVED
}

enum FineArchiveReason {
  MISSING_FROM_PROVIDER
  MANUAL_CONFIRMED
}

enum FineInvoiceStatus {
  PENDING
  CREATED
  SANDBOX_RETURNED
  SUCCEEDED
  FAILED
  ERROR
}

enum FineAssignmentSource {
  AUTOMATIC
  AUTO_EXACT
  MANUAL
}

enum ClientStatus {
  DRAFT
  NEW
  VERIFYING
  VERIFIED
  REGULAR
  BLOCKED
  ARCHIVED
}

enum ClientDocumentCategory {
  PASSPORT
  DRIVER_LICENSE
  CONTRACT
  POWER_OF_ATTORNEY
  MEDICAL
  OTHER
}

enum ClientCommentCategory {
  GENERAL
  POSITIVE
  PROBLEM
  DAMAGE
  PAYMENT
  VIOLATION
  HANDOVER_RETURN
  DOCUMENTS
}

enum ClientCommentSeverity {
  INFO
  WARNING
  DANGER
}

enum ClientCommentProblemStatus {
  OPEN
  RESOLVED
}

enum ClientRatingEventSource {
  AUTOMATIC
  MANUAL
}

enum ClientRatingEventType {
  CLEAN_RENTAL
  ON_TIME_RETURN
  CLEAN_RENTAL_STREAK
  LATE_RETURN
  UNPAID_CONFIRMED_FINE
  DAMAGE
  CONTRACT_VIOLATION
  MANUAL_POSITIVE
  MANUAL_NEGATIVE
}

enum ClientRatingEventReason {
  CLEAN_RENTAL_COMPLETED
  ON_TIME_RETURN_COMPLETED
  CLEAN_RENTAL_STREAK_COMPLETED
  LATE_RETURN_CONFIRMED
  UNPAID_CONFIRMED_FINE
  DAMAGE_CONFIRMED
  CONTRACT_VIOLATION_CONFIRMED
  MANUAL_COMMENT
}

enum DocumentScanStatus {
  UPLOADING
  PENDING
  CLEAN
  BLOCKED
  ERROR
  ARCHIVED
}

enum AuditAction {
  CREATE
  UPDATE
  ASSIGN
  BLOCK
  ARCHIVE
  DELETE
  VIEW
  DOWNLOAD
  SCAN
}

enum AuditEntityType {
  COMPANY
  CLIENT
  USER
  ROLE
  VEHICLE
  DEVICE
  DOCUMENT
  CLIENT_DOCUMENT
  RENTAL
  FINE
  FINE_INTEGRATION
  SYSTEM
}

enum VehicleStatus {
  MOVING
  IDLE
  OFFLINE
  MAINTENANCE
  UNKNOWN
}

enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
  OTHER
}

enum TelemetrySeverity {
  INFO
  WARNING
  DANGER
}

enum ManualVehicleEventKind {
  NOTE
  INCIDENT
  ASSIGNMENT
}

enum MaintenanceStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
  DAMAGE_REPORTED
  WAITING_REPAIR
}

enum MaintenanceRecordType {
  MAINTENANCE
  REPAIR
}

enum MaintenanceKind {
  OIL
  FILTERS
  BRAKES
  TIRES
  TIMING
  INSPECTION
  OTHER
}

enum MaintenanceAttachmentKind {
  DAMAGE_BEFORE
  REPAIR_AFTER
  DOCUMENT
  RECEIPT
}

enum WashStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum WashKind {
  BODY
  COMPLEX
  INTERIOR
  MATS
  ENGINE
  OTHER
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  WARNING
  UNASSIGNED
  DISABLED
}

enum DeviceConnectionType {
  LTE
  GSM
  NONE
}

enum DevicePowerSource {
  VEHICLE
  BATTERY
}

enum FirmwareChannel {
  STABLE
  BETA
}

enum DeviceCommandType {
  REBOOT
  SHUTDOWN
  UPDATE_FIRMWARE
}

enum DeviceCommandStatus {
  PENDING
  SENT
  COMPLETED
  FAILED
  CANCELLED
}

enum RentalStatus {
  DRAFT
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum RentalAgreementType {
  STANDARD
  LEASE_TO_OWN
}

enum RentalDocumentFormat {
  DOCX
  PDF
}

enum RentalDocumentGenerationStatus {
  PENDING
  PROMOTED
  CLEANING
  COMMITTED
  ERROR
}

enum RentalOperationType {
  HANDOVER
  EXTENSION
  RETURN
  DEPOSIT_RETURN
  WEEKLY_INSPECTION
}

enum RentalOperationStatus {
  DRAFT
  COMMITTED
  ERROR
}

enum RentalEvidenceStatus {
  COMPLETE
  VIDEO_MISSING
  DASHBOARD_PHOTO_MISSING
  MISSING
}

enum RentalOperationMediaKind {
  INSPECTION_VIDEO
  DASHBOARD_PHOTO
  BODY_PHOTO_FRONT
  BODY_PHOTO_REAR
  BODY_PHOTO_LEFT
  BODY_PHOTO_RIGHT
}

enum RentalOperationMediaStatus {
  PENDING
  SCANNING
  CLEAN
  BLOCKED
  CLEANING
  ERROR
}

enum RentalFulfillmentMethod {
  OFFICE
  DELIVERY
}

enum RentalDepositStatus {
  NOT_COLLECTED
  COLLECTED
  RETURNED
  PARTIALLY_WITHHELD
  WITHHELD
}

enum DepositLedgerEntryKind {
  DEPOSIT_PAYMENT
  MANUAL_CREDIT
  FINE_RESERVATION
  FINE_RESERVATION_ADJUSTMENT
  FINE_RESERVATION_RELEASE
  FINE_WITHHOLDING
  DEPOSIT_RETURN
  DEBT_PAYMENT
  MANUAL_CORRECTION
}

enum DepositLedgerEntrySource {
  AUTOMATIC
  STAFF
  MIGRATION
}

enum RentalPaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

enum RentalPaymentKind {
  RENT
  DEPOSIT
}

enum RentalPaymentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RentalSignatureParty {
  CLIENT
  COMPANY
}

enum RentalSignatureStatus {
  MISSING
  SIGNED
  REVOKED
}

enum RentalVehicleCondition {
  GOOD
  DAMAGE_RECORDED
}

enum TelegramIdentityKind {
  CLIENT
  STAFF
}

enum BotFulfillmentMode {
  OFFICE
  DELIVERY
}

enum BotRentalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum BotNotificationStatus {
  PENDING
  PROCESSING
  SENT
  ERROR
  CANCELLED
}

enum GpsNotificationMode {
  RECORD_ONLY
  STAFF_ONLY
  STAFF_AND_CLIENT
}

enum OperationsTaskStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum OperationsTaskPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  BOOKED
  LOST
}

enum OwnerProfileStatus {
  ACTIVE
  BLOCKED
}

enum OwnerLedgerEntryKind {
  ACCRUAL
  REVERSAL
  ADJUSTMENT
  PAYOUT
}

model User {
  id                       String                    @id @default(cuid())
  email                    String                    @unique
  login                    String?                   @unique
  name                     String
  avatarPath               String?
  profileBannerPath        String?
  passwordHash             String
  role                     UserRole                  @default(MEMBER)
  isActive                 Boolean                   @default(true)
  sessions                 Session[]
  memberships              CompanyMember[]
  deviceCommands           DeviceCommand[]
  manualVehicleEvents      ManualVehicleEvent[]
  eventReadReceipts        EventReadReceipt[]
  auditLogs                AuditLog[]
  createdClients           Client[]
  createdClientDocuments   ClientDocument[]
  clientUploadPermits      ClientUploadPermit[]
  createdRentals           Rental[]                  @relation("RentalCreatedBy")
  confirmedRentals         Rental[]                  @relation("RentalConfirmedBy")
  createdContractTemplates ContractTemplateVersion[] @relation("ContractTemplateCreatedBy")
  archivedVehicles         Vehicle[]                 @relation("VehicleArchivedBy")
  authoredClientComments   ClientComment[]           @relation("ClientCommentAuthor")
  hiddenClientComments     ClientComment[]           @relation("ClientCommentHiddenBy")
  authoredFineComments     Fine[]                    @relation("FineCommentAuthor")
  confirmedFineAssignments Fine[]                    @relation("FineAssignmentConfirmedBy")
  fineAssignments          FineAssignmentHistory[]   @relation("FineAssignmentActor")
  initiatedFineInvoices    FineInvoice[]             @relation("FineInvoiceInitiatedBy")
  telegramIdentities       TelegramIdentity[]        @relation("TelegramIdentityUser")
  createdTelegramInvites   TelegramInvite[]          @relation("TelegramInviteCreator")
  boundTelegramGroups      TelegramGroupBinding[]
  decidedBotRentalRequests BotRentalRequest[]        @relation("BotRentalRequestDecider")
  rentalOperations         RentalOperation[]         @relation("RentalOperationActor")
  recordedRentalPayments   RentalPayment[]           @relation("RentalPaymentRecorder")
  recordedRentalSignatures RentalSignature[]         @relation("RentalSignatureRecorder")
  createdOperationsTasks   OperationsTask[]          @relation("OperationsTaskCreatedBy")
  assignedOperationsTasks  OperationsTask[]          @relation("OperationsTaskAssignedTo")
  completedOperationsTasks OperationsTask[]          @relation("OperationsTaskCompletedBy")
  createdLeads             Lead[]                    @relation("LeadCreatedBy")
  assignedLeads            Lead[]                    @relation("LeadAssignedTo")
  assignedOwnerVehicles    OwnerVehicleAccess[]      @relation("OwnerVehicleAccessAssignedBy")
  depositLedgerEntries     DepositLedgerEntry[]      @relation("DepositLedgerEntryActor")
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model LoginThrottle {
  email          String    @id
  failedAttempts Int       @default(0)
  lastFailedAt   DateTime?
  lockedUntil    DateTime?
}

model Company {
  id                        String                       @id @default(cuid())
  name                      String
  slug                      String                       @unique
  inn                       String?
  kpp                       String?
  ogrn                      String?
  directorName              String?
  legalAddress              String?
  actualAddress             String?
  phone                     String?
  email                     String?
  legalName                 String?
  entrepreneurName          String?
  lessorBirthDate           DateTime?                    @db.Date
  lessorPassportEncrypted   String?
  ogrnip                    String?
  bankName                  String?
  settlementAccount         String?
  correspondentAccount      String?
  bik                       String?
  contractCity              String?
  defaultPickupAddress      String?
  defaultReturnAddress      String?
  signatoryName             String?
  signatoryAuthority        String?
  isDemo                    Boolean                      @default(false)
  members                   CompanyMember[]
  vehicles                  Vehicle[]
  devices                   Device[]
  deviceCommands            DeviceCommand[]
  manualVehicleEvents       ManualVehicleEvent[]
  eventReadReceipts         EventReadReceipt[]
  auditLogs                 AuditLog[]
  clients                   Client[]
  clientDocuments           ClientDocument[]
  clientUploadPermits       ClientUploadPermit[]
  clientStorageLedger       ClientStorageLedger?
  rentals                   Rental[]
  rentalNumberCounters      RentalNumberCounter[]
  rentalDrivers             RentalDriver[]
  rentalDocumentVersions    RentalDocumentVersion[]
  rentalDocumentGenerations RentalDocumentGeneration[]
  rentalOperations          RentalOperation[]
  rentalOperationMedia      RentalOperationMedia[]
  rentalPayments            RentalPayment[]
  rentalPaymentReceipts     RentalPaymentReceipt[]
  rentalSignatures          RentalSignature[]
  contractTemplates         ContractTemplateVersion[]
  clientComments            ClientComment[]
  clientRatingEvents        ClientRatingEvent[]
  fineIntegration           FineIntegration?
  externalVehicleLinks      ExternalVehicleLink[]
  telematicsIntegration     TelematicsIntegration?
  telematicsVehicleLinks    TelematicsVehicleLink[]
  fines                     Fine[]
  fineAssignmentHistory     FineAssignmentHistory[]
  fineInvoices              FineInvoice[]
  telegramIdentities        TelegramIdentity[]
  telegramInvites           TelegramInvite[]
  telegramGroupBinding      TelegramGroupBinding?
  botRentalRequests         BotRentalRequest[]
  botNotificationJobs       BotNotificationJob[]
  vehicleEvents             VehicleEvent[]
  gpsSettings               CompanyGpsSettings?
  vehicleGpsOverrides       VehicleGpsSettingsOverride[]
  gpsClientWarnings         GpsClientWarning[]
  vehicleServiceVisits      VehicleServiceVisit[]
  operationsTasks           OperationsTask[]
  leads                     Lead[]
  avitoInboxEvents          AvitoInboxEvent[]
  avitoDialogues            AvitoDialogue[]
  avitoOutgoing             AvitoOutgoing[]
  ownerProfiles             OwnerProfile[]
  ownerVehicleAccess        OwnerVehicleAccess[]
  ownerRevenueRules         OwnerRevenueRule[]
  ownerLedgerEntries        OwnerLedgerEntry[]
  depositLedgerEntries      DepositLedgerEntry[]
  createdAt                 DateTime                     @default(now())
  updatedAt                 DateTime                     @updatedAt
}

model Lead {
  id               String     @id @default(cuid())
  companyId        String
  company          Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name             String
  lastName         String?
  phoneEncrypted   String
  phoneIndex       String
  source           String?
  commentEncrypted String?
  status           LeadStatus @default(NEW)
  nextContactAt    DateTime?  @db.Timestamptz(3)
  createdByUserId  String
  createdBy        User       @relation("LeadCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  assignedToUserId String?
  assignedTo       User?      @relation("LeadAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @db.Timestamptz(3)

  @@index([companyId, status, createdAt])
  @@index([companyId, status, nextContactAt])
  @@index([companyId, phoneIndex])
  @@index([assignedToUserId, status])
}

model OperationsTask {
  id                String                 @id @default(cuid())
  companyId         String
  company           Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  dueAt             DateTime
  priority          OperationsTaskPriority @default(NORMAL)
  status            OperationsTaskStatus   @default(OPEN)
  href              String?
  createdByUserId   String
  createdBy         User                   @relation("OperationsTaskCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  assignedToUserId  String?
  assignedTo        User?                  @relation("OperationsTaskAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  completedByUserId String?
  completedBy       User?                  @relation("OperationsTaskCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)
  completedAt       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([companyId, status, dueAt])
  @@index([assignedToUserId, status, dueAt])
}

model CompanyMember {
  id                     String              @id @default(cuid())
  companyId              String
  company                Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId                 String
  user                   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  role                   CompanyRole         @default(VIEWER)
  additionalPermissions  CompanyPermission[] @default([])
  resolvedClientComments ClientComment[]     @relation("ClientCommentResolvedBy")
  ratingEvents           ClientRatingEvent[] @relation("ClientRatingEventActor")
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@unique([companyId, userId])
  @@index([userId])
}

model Client {
  id                           String               @id @default(cuid())
  companyId                    String
  company                      Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  firstName                    String
  middleName                   String?
  lastName                     String
  birthDate                    DateTime?
  gender                       String?
  phoneEncrypted               String?
  phoneIndex                   String?
  additionalPhoneEncrypted     String?
  email                        String?
  telegramUsername             String?
  telegramUserId               String?
  maxUserId                    String?
  photoPath                    String?
  photoBytes                   Int                  @default(0)
  registrationAddressEncrypted String?
  actualAddressEncrypted       String?
  passportEncrypted            String?
  passportIndex                String?
  driverLicenseEncrypted       String?
  driverLicenseIndex           String?
  driverCategories             String[]
  driverLicenseIssuedAt        DateTime?
  driverLicenseExpiresAt       DateTime?
  drivingSince                 DateTime?
  emergencyContactEncrypted    String?
  source                       String?
  note                         String?
  status                       ClientStatus         @default(NEW)
  createdByUserId              String
  createdBy                    User                 @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt                    DateTime             @default(now())
  updatedAt                    DateTime             @updatedAt
  archivedAt                   DateTime?
  documents                    ClientDocument[]
  photoUploads                 ClientPhotoUpload[]
  rentals                      Rental[]             @relation("ClientRentals")
  rentalDriverLinks            RentalDriver[]       @relation("ClientRentalDriver")
  comments                     ClientComment[]
  ratingEvents                 ClientRatingEvent[]
  fines                        Fine[]
  telegramIdentity             TelegramIdentity?
  botRentalRequests            BotRentalRequest[]
  rentalOperations             RentalOperation[]
  maintenanceRecords           MaintenanceRecord[]
  depositLedgerEntries         DepositLedgerEntry[]
  vehicleEvents                VehicleEvent[]
  gpsClientWarnings            GpsClientWarning[]

  @@unique([companyId, phoneIndex])
  @@unique([companyId, id])
  @@index([companyId, status, updatedAt])
  @@index([companyId, lastName, firstName])
}

model ClientPhotoUpload {
  id                   String    @id @default(cuid())
  uploadId             String    @unique
  companyId            String
  clientId             String
  client               Client    @relation(fields: [companyId, clientId], references: [companyId, id], onDelete: Cascade)
  sourceStorageKey     String
  finalStorageKey      String    @unique
  previousPhotoPath    String?
  sourceBytes          Int       @default(0)
  finalBytes           Int?
  previousPhotoBytes   Int       @default(0)
  ledgerCommittedBytes Int       @default(0)
  status               String    @default("PENDING")
  scanVerdict          String?
  claimToken           String?   @unique
  sha256               String?
  leaseExpiresAt       DateTime?
  committedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([status, leaseExpiresAt])
  @@index([companyId, clientId, status])
}

model ClientComment {
  id                   String                      @id @default(cuid())
  companyId            String
  company              Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientId             String
  client               Client                      @relation(fields: [companyId, clientId], references: [companyId, id], onDelete: Cascade)
  rentalId             String?
  rental               Rental?                     @relation(fields: [companyId, rentalId], references: [companyId, id], onDelete: Restrict)
  authorUserId         String
  author               User                        @relation("ClientCommentAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  category             ClientCommentCategory       @default(GENERAL)
  severity             ClientCommentSeverity       @default(INFO)
  text                 String
  isPinned             Boolean                     @default(false)
  problemStatus        ClientCommentProblemStatus?
  resolvedAt           DateTime?                   @db.Timestamptz(3)
  resolvedByUserId     String?
  resolvedByMembership CompanyMember?              @relation("ClientCommentResolvedBy", fields: [companyId, resolvedByUserId], references: [companyId, userId], onDelete: Restrict)
  affectsRating        Boolean?
  ratingDelta          Int?
  hiddenAt             DateTime?
  hiddenByUserId       String?
  hiddenBy             User?                       @relation("ClientCommentHiddenBy", fields: [hiddenByUserId], references: [id], onDelete: Restrict)
  ratingEvent          ClientRatingEvent?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  @@unique([companyId, id])
  @@index([companyId, clientId, isPinned, createdAt])
  @@index([companyId, rentalId, createdAt])
}

model ClientRatingEvent {
  id              String                  @id @default(cuid())
  companyId       String
  company         Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  clientId        String
  client          Client                  @relation(fields: [companyId, clientId], references: [companyId, id], onDelete: Restrict)
  source          ClientRatingEventSource
  type            ClientRatingEventType
  delta           Int
  reason          ClientRatingEventReason
  idempotencyKey  String?                 @unique
  rentalId        String?
  rental          Rental?                 @relation(fields: [companyId, rentalId], references: [companyId, id], onDelete: Restrict)
  fineId          String?
  fine            Fine?                   @relation(fields: [companyId, fineId], references: [companyId, id], onDelete: Restrict)
  vehicleId       String?
  vehicle         Vehicle?                @relation(fields: [companyId, vehicleId], references: [companyId, id], onDelete: Restrict)
  commentId       String?                 @unique
  comment         ClientComment?          @relation(fields: [companyId, commentId], references: [companyId, id], onDelete: Restrict)
  actorUserId     String?
  actorMembership CompanyMember?          @relation("ClientRatingEventActor", fields: [companyId, actorUserId], references: [companyId, userId], onDelete: Restrict)
  createdAt       DateTime                @default(now()) @db.Timestamptz(3)

  @@unique([companyId, commentId])
  @@index([companyId, clientId, createdAt])
}

model ClientDocument {
  id              String                  @id @default(cuid())
  companyId       String
  company         Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientId        String
  client          Client                  @relation(fields: [companyId, clientId], references: [companyId, id], onDelete: Cascade)
  category        ClientDocumentCategory
  title           String
  numberEncrypted String?
  issuedAt        DateTime?
  expiresAt       DateTime?
  status          DocumentScanStatus      @default(UPLOADING)
  currentVersion  Int                     @default(1)
  createdByUserId String
  createdBy       User                    @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  archivedAt      DateTime?
  versions        ClientDocumentVersion[]
  rentalDocuments RentalDocumentVersion[]

  @@unique([companyId, clientId, id])
  @@index([companyId, clientId, status])
}

model ClientDocumentVersion {
  id                    String                 @id @default(cuid())
  documentId            String
  document              ClientDocument         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadId              String?                @unique
  version               Int
  storageKey            String                 @unique
  previewStorageKey     String?                @unique
  previewMime           String?
  previewBytes          Int?
  previewSha256         String?
  previewGeneratedAt    DateTime?
  originalName          String
  verifiedMime          String
  bytes                 Int
  sha256                String
  scanEngine            String?
  signatureVersion      String?
  scanVerdict           String?
  scanLeaseExpiresAt    DateTime?
  claimToken            String?                @unique
  scanRetryCount        Int                    @default(0)
  quarantineExpiresAt   DateTime?
  cleanupPending        Boolean                @default(false)
  cleanupLeaseExpiresAt DateTime?
  storageDeletedAt      DateTime?
  ledgerCommittedBytes  Int                    @default(0)
  scannedAt             DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  rentalDocumentVersion RentalDocumentVersion?

  @@unique([documentId, version])
  @@unique([documentId, id])
  @@index([documentId, createdAt])
  @@index([scanVerdict, scanLeaseExpiresAt])
  @@index([cleanupPending, cleanupLeaseExpiresAt])
}

model ClientUploadPermit {
  id             String    @id @default(cuid())
  uploadId       String    @unique
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind           String
  status         String    @default("ACTIVE")
  reservedBytes  Int
  leaseExpiresAt DateTime
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([companyId, status, leaseExpiresAt])
  @@index([userId, status, leaseExpiresAt])
  @@index([companyId, createdAt])
  @@index([userId, createdAt])
}

model ClientStorageLedger {
  companyId      String    @id
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  committedBytes BigInt    @default(0)
  reservedBytes  BigInt    @default(0)
  reconciledAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model AuditLog {
  id                 String          @id @default(cuid())
  companyId          String?
  company            Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  actorUserId        String?
  actorUser          User?           @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorEmailSnapshot String
  action             AuditAction
  entityType         AuditEntityType
  entityId           String?
