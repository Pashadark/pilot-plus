{
  "name": "pilot-plus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"*.{json,md,ts,mjs,yaml}\"",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "db:seed": "tsx src/database/prisma/seed.ts",
    "db:preflight:maintenance": "tsx scripts/maintenance-migration-preflight.ts",
    "vehicles:sync-images": "tsx scripts/sync-vehicle-images.ts",
    "test:e2e": "playwright test",
    "test:e2e:auth": "playwright test tests/auth.spec.ts --workers=1",
    "test:e2e:install": "playwright install chromium"
  },
  "prisma": {
    "schema": "src/database/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "6.16.2",
    "framer-motion": "^12.42.2",
    "maplibre-gl": "^5.24.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.7.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "prisma": "6.16.2",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
