DATABASE_URL="postgresql://pilot:change-me@localhost:5433/pilot?schema=public"
PILOT_ADMIN_EMAIL="admin@example.com"
PILOT_ADMIN_PASSWORD="replace-with-at-least-12-characters"
PILOT_ADMIN_NAME="Администратор Pilot+"
CLIENT_DATA_ENCRYPTION_KEY="replace-with-base64-encoded-32-byte-key"
CLIENT_SEARCH_KEY="replace-with-a-long-random-search-key"
# Development-only root. В production задайте абсолютный server-owned путь вне repo/public/.next/.git
# с ACL только для пользователя приложения. Repo-local override не включайте без security review.
PRIVATE_STORAGE_ROOT="./.pilot-private-storage"
# PRIVATE_STORAGE_ALLOW_REPO_ROOT="false"
# Для npm run dev на хосте используйте:
# docker compose -f compose.yaml -f compose.dev.yaml up -d
CLAMAV_HOST="127.0.0.1"
# В контейнерном приложении задайте CLAMAV_HOST="clamav" без публикации порта в base Compose.
CLAMAV_PORT="3310"
CLAMAV_TIMEOUT_MS="30000"
# Fail-closed quarantine: 3 повтора в течение bounded retention, затем secure cleanup.
CLIENT_DOCUMENT_STALE_UPLOAD_MINUTES="15"
CLIENT_DOCUMENT_SCAN_RETRY_MAX="3"
CLIENT_DOCUMENT_QUARANTINE_RETENTION_HOURS="24"
# Durable PostgreSQL limits действуют и для документов, replacement, и для фото.
CLIENT_UPLOAD_RATE_WINDOW_MINUTES="10"
CLIENT_UPLOAD_RATE_USER_MAX="20"
CLIENT_UPLOAD_RATE_COMPANY_MAX="100"
CLIENT_UPLOAD_CONCURRENT_USER_MAX="2"
CLIENT_UPLOAD_CONCURRENT_COMPANY_MAX="6"
CLIENT_PRIVATE_STORAGE_QUOTA_MB="1024"
# Только для ручного live integration test; обычные unit tests не требуют ClamAV.
# RUN_CLAMAV_INTEGRATION="1"
