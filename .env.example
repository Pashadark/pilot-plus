DATABASE_URL="postgresql://pilot:change-me@localhost:5433/pilot?schema=public"
PILOT_ADMIN_EMAIL="admin@example.com"
PILOT_ADMIN_PASSWORD="replace-with-at-least-12-characters"
PILOT_ADMIN_NAME="Администратор Pilot+"
CLIENT_DATA_ENCRYPTION_KEY="replace-with-base64-encoded-32-byte-key"
CLIENT_SEARCH_KEY="replace-with-a-long-random-search-key"
PRIVATE_STORAGE_ROOT="./.pilot-private-storage"
# Для npm run dev на хосте используйте Compose development override с loopback-портом.
CLAMAV_HOST="127.0.0.1"
# В контейнерном приложении задайте CLAMAV_HOST="clamav" без публикации порта в base Compose.
CLAMAV_PORT="3310"
CLAMAV_TIMEOUT_MS="30000"
